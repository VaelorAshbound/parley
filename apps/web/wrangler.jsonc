{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "parley",
  // src/server.ts: /api/* goes to Hono, everything else to TanStack Start.
  // A custom entry also gives us scheduled() for the cron jobs (T28).
  "main": "src/server.ts",
  "compatibility_date": "2026-09-23",
  // Production lives on the custom domain (T38), not workers.dev. Previews
  // still get workers.dev URLs so each branch can be tested (T3).
  "workers_dev": false,
  "preview_urls": true,
  // enable_request_signal: request.signal aborts when the client leaves, so
  // oRPC can stop the work (and the LLM spend) with it (spec §5 API).
  "compatibility_flags": ["nodejs_compat", "enable_request_signal"],
  // Declared so `wrangler types` works without .dev.vars (CI), and deploys
  // fail when one is missing. Previews get theirs from the Previews base
  // config (`wrangler preview base-config secret put`).
  "secrets": {
    "required": ["BETTER_AUTH_SECRET"],
  },
  "vars": {
    "STAGE": "production",
  },
  // The deployed version's tag (the commit), so CI can wait until a Preview
  // serves the commit it is testing.
  "version_metadata": {
    "binding": "CF_VERSION_METADATA",
  },
  // Browser Run makes the PDFs. quickAction() has no local simulator, so dev
  // uses the real service (10 browser hours/month are in Workers Paid).
  "browser": {
    "binding": "BROWSER",
    "remote": true,
  },
  // Neon through Hyperdrive with query caching OFF: a cached SELECT would
  // show a stale draft or a revoked share link (spec §5 Database). Local dev
  // uses the Postgres from `pnpm db:dev`.
  "hyperdrive": [
    {
      "binding": "HYPERDRIVE",
      // "parley" → the Neon production branch
      "id": "904889e1abe144c4a434c382a53f03a4",
      "localConnectionString": "postgres://postgres:postgres@localhost:54320/parley",
    },
  ],
  // Worker Previews (one per branch) get their own binding list; wrangler
  // preview refuses to run without it.
  // https://developers.cloudflare.com/workers/previews/configuration/
  "previews": {
    // Turns on Server-Timing headers for DevTools (spec §5 Hono).
    "vars": {
      "STAGE": "preview",
    },
    "version_metadata": {
      "binding": "CF_VERSION_METADATA",
    },
    "browser": {
      "binding": "BROWSER",
    },
    // Previews never touch production data. "parley-preview" → the Neon
    // "preview" branch, until T33 gives each PR its own branch.
    "hyperdrive": [
      {
        "binding": "HYPERDRIVE",
        "id": "fc5e4caf73334f3ea148a21c83e83695",
        "localConnectionString": "postgres://postgres:postgres@localhost:54320/parley",
      },
    ],
  },
  "observability": {
    "enabled": true,
    "head_sampling_rate": 1,
  },
  "upload_source_maps": true,
}
