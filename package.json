{
  "name": "parley",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "prepare": "vp config",
    "dev": "vp -C apps/web dev",
    "build": "vp run -r build",
    "documents:build": "vp run --filter @workspace/documents build",
    "db:dev": "vp run --filter @workspace/db dev",
    "db:generate": "vp run --filter @workspace/db generate",
    "db:migrate": "vp run --filter @workspace/db migrate",
    "db:check": "vp run --filter @workspace/db check-migrations",
    "db:auth-schema": "vp run --filter @workspace/db auth-schema",
    "check": "vp check",
    "test": "vp test run",
    "test:coverage": "vp test run --coverage",
    "test:workers": "vp run --filter web-worker-tests test",
    "deploy": "vp run --filter web deploy",
    "test:workers:real": "vp run --filter web-worker-tests test:real",
    "test:e2e": "vp run --filter web test:e2e"
  },
  "devDependencies": {
    "@vitest/coverage-v8": "5.0.1",
    "typescript": "catalog:",
    "vite-plus": "catalog:"
  },
  "packageManager": "pnpm@12.4.2",
  "engines": {
    "node": "^24.11.0"
  }
}
